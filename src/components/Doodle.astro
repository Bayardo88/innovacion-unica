---
/** Garabatos decorativos dibujados a mano. Siempre aria-hidden. */
interface Props { kind: 'arrow' | 'star' | 'smiley' | 'scribble' | 'circle' | 'underline' | 'spark'; class?: string; color?: string }
const { kind, class: cls, color = 'var(--ink)' } = Astro.props;
const shapes = {
  arrow: { vb: '0 0 120 80', d: '<path d="M6 14c22 4 52 12 70 34 8 10 11 18 12 24"/><path d="M74 62c6 4 10 8 14 11 3-6 6-12 11-17"/>' },
  star: { vb: '0 0 60 60', d: '<path d="M30 5c2 12 5 19 8 22 4 3 11 4 18 4-8 3-14 6-16 9-3 5-4 12-5 16-3-7-6-13-10-15-4-3-11-4-17-4 7-3 12-6 14-9 3-5 6-14 8-23z"/>' },
  smiley: { vb: '0 0 64 64', d: '<path d="M33 6c15 0 26 11 25 27-1 14-12 25-27 24C17 56 6 45 7 30 8 16 19 6 33 6z"/><path d="M23 25v4M40 24v4"/><path d="M20 37c5 8 18 10 25 0"/>' },
  scribble: { vb: '0 0 140 40', d: '<path d="M4 26c10-14 18-16 22-8s-4 14 4 12 14-20 22-16 0 18 8 16 14-22 24-18-2 18 8 16 16-18 26-14 8 10 18 6"/>' },
  circle: { vb: '0 0 200 90', d: '<path d="M30 20C70 2 160 4 186 30c18 20-24 46-90 50C30 84 6 64 14 44c6-16 30-26 62-30"/>' },
  underline: { vb: '0 0 200 20', d: '<path d="M4 12c40-6 90-9 140-6 18 1 34 3 52 6"/><path d="M30 17c40-4 80-5 120-3"/>' },
  spark: { vb: '0 0 60 60', d: '<path d="M30 6v14M30 40v14M6 30h14M40 30h14M13 13l9 9M38 38l9 9M47 13l-9 9M22 38l-9 9"/>' },
} as const;
const s = shapes[kind];
---
<svg class={cls} viewBox={s.vb} fill="none" stroke={color} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={s.d} />
