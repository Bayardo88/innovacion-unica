---
import { youtubeId } from '../lib/projects';
import Icon from './Icon.astro';
/** Video de YouTube liviano: muestra la miniatura y carga el reproductor al hacer clic. */
interface Props { url: string; title: string }
const { url, title } = Astro.props;
const id = youtubeId(url);
---
{id ? (
  <div class="yt" data-yt={id}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
    <button type="button" class="yt__play" aria-label={`Reproducir video: ${title}`}>
      <Icon name="play" size={28} />
    </button>
  </div>
) : (
  <a href={url} class="link-arrow" rel="noopener">Ver video en YouTube <Icon name="external" /></a>
)}
<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = el.querySelector('button')?.getAttribute('aria-label')?.replace('Reproducir video: ', 'Video: ') ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
<style>
  .yt { position: relative; aspect-ratio: 16 / 9; background: var(--ink); overflow: hidden; border: 1px solid var(--ink); }
  .yt img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .yt__play {
    position: absolute; inset: 0; margin: auto; width: 84px; height: 84px;
    display: grid; place-items: center; border-radius: 50%;
    background: var(--yellow); color: var(--ink); border: 2px solid var(--ink); cursor: pointer;
    box-shadow: var(--shadow-paper); transition: transform 180ms var(--ease-out);
  }
  .yt__play:hover { transform: scale(1.06); }
</style>
